# Copy to .env for local overrides. Never commit a real .env file.
# Leave API_KEY unset for the public GitHub Pages dashboard.

ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Exact browser origins only. Wildcard * is rejected by the application.
CORS_ALLOW_ORIGINS=https://mohamdmamdoh83-coder.github.io

# Optional. If set, browsers cannot send it; GitHub Pages will receive 401.
# API_KEY=

API_RATE_LIMIT=60
API_RATE_WINDOW_SECONDS=60
MAX_REQUEST_BYTES=27262976
TRUST_PROXY_HEADERS=true
ENABLE_API_DOCS=false
