# Copy to .env for local overrides. Never commit a real .env file.
# Leave API_KEY unset for the public GitHub Pages dashboard.

ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Exact browser origins only. Wildcard * is rejected by the application.
CORS_ALLOW_ORIGINS=https://mohamdmamdoh83-coder.github.io

# Optional. If set, browsers cannot send it; GitHub Pages will receive 401.
# API_KEY=

API_RATE_LIMIT=60
API_RATE_WINDOW_SECONDS=60
MAX_REQUEST_BYTES=27262976
TRUST_PROXY_HEADERS=true

# Reverse-proxy trust (P1 hardening). Never '*'.
# IPs/CIDRs allowed to set X-Forwarded-* at the uvicorn layer (Procfile/Dockerfile).
FORWARDED_ALLOW_IPS=127.0.0.1
# Direct peers whose X-Forwarded-For is trusted for client-IP/rate limiting.
# Set both to your platform's proxy addresses (e.g. Fly/Render proxy ranges).
TRUSTED_PROXY_IPS=127.0.0.1,::1

# Optional distributed rate limiting across workers/instances. When unset (or
# the optional 'redis' package is missing/unreachable) the API falls back to
# the in-process limiter without failing.
# REDIS_URL=redis://localhost:6379/0

ENABLE_API_DOCS=false
